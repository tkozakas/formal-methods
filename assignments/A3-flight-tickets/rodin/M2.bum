<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
    <org.eventb.core.refinesMachine name="'" org.eventb.core.target="M1"/>
    <org.eventb.core.seesContext name="(" org.eventb.core.target="C1"/>
    <org.eventb.core.variable name=")" org.eventb.core.identifier="available"/>
    <org.eventb.core.event name="*" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="INITIALISATION"/>
    <org.eventb.core.event name="+" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="book">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="book"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="," org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="cancel">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="cancel"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="-" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="book_connecting">
        <org.eventb.core.parameter name="'" org.eventb.core.identifier="c1"/>
        <org.eventb.core.parameter name="(" org.eventb.core.identifier="c3"/>
        <org.eventb.core.parameter name=")" org.eventb.core.identifier="d"/>
        <org.eventb.core.parameter name="*" org.eventb.core.identifier="max_total"/>
        <org.eventb.core.parameter name="+" org.eventb.core.identifier="c2"/>
        <org.eventb.core.parameter name="," org.eventb.core.identifier="f1"/>
        <org.eventb.core.parameter name="-" org.eventb.core.identifier="f2"/>
        <org.eventb.core.guard name="." org.eventb.core.label="grd1" org.eventb.core.predicate="c1 ∈ CITIES ∧ c2 ∈ CITIES ∧ c3 ∈ CITIES"/>
        <org.eventb.core.guard name="/" org.eventb.core.label="grd2" org.eventb.core.predicate="c1 ≠ c2 ∧ c2 ≠ c3 ∧ c1 ≠ c3"/>
        <org.eventb.core.guard name="0" org.eventb.core.label="grd3" org.eventb.core.predicate="f1 ∈ FLIGHTS ∧ f2 ∈ FLIGHTS ∧ f1 ≠ f2"/>
        <org.eventb.core.guard name="1" org.eventb.core.label="grd4" org.eventb.core.predicate="dep(f1) = c1 ∧ dest(f1) = c2"/>
        <org.eventb.core.guard name="2" org.eventb.core.label="grd5" org.eventb.core.predicate="dep(f2) = c2 ∧ dest(f2) = c3"/>
        <org.eventb.core.guard name="3" org.eventb.core.label="grd6" org.eventb.core.predicate="f1 ↦ d ∈ schedule ∧ f2 ↦ d ∈ schedule"/>
        <org.eventb.core.guard name="4" org.eventb.core.label="grd7" org.eventb.core.predicate="available(f1 ↦ d) ≥ 1 ∧ available(f2 ↦ d) ≥ 1"/>
        <org.eventb.core.guard name="5" org.eventb.core.label="grd8" org.eventb.core.predicate="max_total ∈ ℕ"/>
        <org.eventb.core.guard name="6" org.eventb.core.label="grd9" org.eventb.core.predicate="price(f1 ↦ d) + price(f2 ↦ d) ≤ max_total"/>
        <org.eventb.core.action name="7" org.eventb.core.assignment="available ≔ available  {f1 ↦ d ↦ available(f1 ↦ d) − 1, f2 ↦ d ↦ available(f2 ↦ d) − 1}" org.eventb.core.label="act1"/>
    </org.eventb.core.event>
</org.eventb.core.machineFile>
