<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
    <org.eventb.core.seesContext name="'" org.eventb.core.target="C0"/>
    <org.eventb.core.variable name="(" org.eventb.core.identifier="available"/>
    <org.eventb.core.invariant name=")" org.eventb.core.label="inv1" org.eventb.core.predicate="available ∈ schedule → ℕ"/>
    <org.eventb.core.invariant name="*" org.eventb.core.label="inv2" org.eventb.core.predicate="∀f,d · f ↦ d ∈ schedule ⇒ available(f ↦ d) ≤ seats(f)"/>
    <org.eventb.core.event name="+" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="'" org.eventb.core.assignment="available ≔ {fd · fd ∈ schedule ∣ fd ↦ seats(prj1(fd))}" org.eventb.core.label="act1"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="," org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="update_availability">
        <org.eventb.core.parameter name="'" org.eventb.core.identifier="f"/>
        <org.eventb.core.parameter name="(" org.eventb.core.identifier="d"/>
        <org.eventb.core.parameter name=")" org.eventb.core.identifier="newval"/>
        <org.eventb.core.guard name="*" org.eventb.core.label="grd1" org.eventb.core.predicate="f ↦ d ∈ schedule"/>
        <org.eventb.core.guard name="+" org.eventb.core.label="grd2" org.eventb.core.predicate="newval ∈ 0 ‥ seats(f)"/>
        <org.eventb.core.action name="," org.eventb.core.assignment="available(f ↦ d) ≔ newval" org.eventb.core.label="act1"/>
    </org.eventb.core.event>
</org.eventb.core.machineFile>
