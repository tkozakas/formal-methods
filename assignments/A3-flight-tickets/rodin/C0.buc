<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.contextFile org.eventb.core.configuration="org.eventb.core.fwd" version="3">
    <org.eventb.core.carrierSet name="(" org.eventb.core.identifier="CITIES"/>
    <org.eventb.core.carrierSet name=")" org.eventb.core.identifier="FLIGHTS"/>
    <org.eventb.core.carrierSet name="*" org.eventb.core.identifier="DATES"/>
    <org.eventb.core.constant name="+" org.eventb.core.identifier="dep"/>
    <org.eventb.core.constant name="," org.eventb.core.identifier="dest"/>
    <org.eventb.core.constant name="-" org.eventb.core.identifier="seats"/>
    <org.eventb.core.constant name="." org.eventb.core.identifier="schedule"/>
    <org.eventb.core.axiom name="/" org.eventb.core.label="axm1" org.eventb.core.predicate="dep ∈ FLIGHTS → CITIES"/>
    <org.eventb.core.axiom name="0" org.eventb.core.label="axm2" org.eventb.core.predicate="dest ∈ FLIGHTS → CITIES"/>
    <org.eventb.core.axiom name="1" org.eventb.core.label="axm3" org.eventb.core.predicate="∀f · f ∈ FLIGHTS ⇒ dep(f) ≠ dest(f)"/>
    <org.eventb.core.axiom name="2" org.eventb.core.label="axm4" org.eventb.core.predicate="seats ∈ FLIGHTS → ℕ1"/>
    <org.eventb.core.axiom name="3" org.eventb.core.label="axm5" org.eventb.core.predicate="schedule ∈ FLIGHTS ↔ DATES"/>
</org.eventb.core.contextFile>
